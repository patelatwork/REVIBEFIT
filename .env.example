# ──────────────────────────────────────────────────────────
# RevibeFit – Docker Compose environment template
# Copy to `.env` and fill in the blanks.
# ──────────────────────────────────────────────────────────

# ─── Required secrets ─────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ─── Admin bootstrap ──────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=RevibeFit Admin

# ─── CORS / API URL ───────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=/api

# ─── B2B API ──────────────────────────────────────────────
B2B_API_KEY=

# ─── Optional integrations ────────────────────────────────
GEMINI_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=RevibeFit

# ─── Misc ─────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
